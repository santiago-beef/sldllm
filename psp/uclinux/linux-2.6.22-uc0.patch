+#define MCF532x_USB_HOST_INT_NUMBER	(128+48)
+
+#ifdef CONFIG_USB_OTG
+/* Start address of OTG module registers.*/
+#define MCF532x_USB_OTG_REG_START	(0xfc0b0000)
