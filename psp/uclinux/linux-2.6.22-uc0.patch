diff -Naur linux-2.6.22/include/asm-arm/arch-at91/uncompress.h linux-2.6.22-uc0/include/asm-arm/arch-at91/uncompress.h
--- linux-2.6.22/include/asm-arm/arch-at91/uncompress.h	2007-07-12 15:21:52.000000000 +1000
+++ linux-2.6.22-uc0/include/asm-arm/arch-at91/uncompress.h	2007-07-12 15:23:47.000000000 +1000
@@ -33,20 +33,24 @@
  */
 static void putc(int c)
 {
+#ifdef AT91_DBGU
 	void __iomem *sys = (void __iomem *) AT91_BASE_SYS;	/* physical address */
 
 	while (!(__raw_readl(sys + AT91_DBGU_SR) & AT91_DBGU_TXRDY))
 		barrier();
 	__raw_writel(c, sys + AT91_DBGU_THR);
+#endif
 }
 
 static inline void flush(void)
 {
+#ifdef AT91_DBGU
 	void __iomem *sys = (void __iomem *) AT91_BASE_SYS;	/* physical address */
 
 	/* wait for transmission to complete */
 	while (!(__raw_readl(sys + AT91_DBGU_SR) & AT91_DBGU_TXEMPTY))
 		barrier();
+#endif
 }
 
