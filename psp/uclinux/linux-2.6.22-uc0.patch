diff -Naur linux-2.6.22/arch/arm/mach-at91/at91x40.c linux-2.6.22-uc0/arch/arm/mach-at91/at91x40.c
--- linux-2.6.22/arch/arm/mach-at91/at91x40.c	1970-01-01 10:00:00.000000000 +1000
+++ linux-2.6.22-uc0/arch/arm/mach-at91/at91x40.c	2007-07-12 15:26:11.000000000 +1000
@@ -0,0 +1,67 @@
+/*
+ * arch/arm/mach-at91/at91x40.c
+ *
+ * (C) Copyright 2007, Greg Ungerer <gerg@snapgear.com>
+ * Copyright (C) 2005 SAN People
