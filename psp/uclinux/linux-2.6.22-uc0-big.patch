+static void rs_flush_buffer(struct tty_struct *tty)
+{
+	struct NIOS_serial *info = (struct NIOS_serial *)tty->driver_data;
+
+	if (serial_paranoia_check(info, tty->name, "rs_flush_buffer"))
+		return;
