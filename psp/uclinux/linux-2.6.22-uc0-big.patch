+#ifdef FAST_POLL
+static void ks8695_fast_poll(void *arg)
+{
+	PADAPTER_STRUCT Adapter = netdev_priv((struct net_device *)arg);
+	int i, irq;
+
+	if (ks8695_poll_ready) {
+		for (i = 0; (i < 6); i++) {
+			irq = DI.uIntShift + i;
+			if (DI.uIntMask & (1L << irq))
+				ks8695_isr(irq, arg);
+		}
+	}
+}
+#endif
