diff -Naur linux-2.6.22/include/asm-nios2nommu/signal.h linux-2.6.22-uc0/include/asm-nios2nommu/signal.h
--- linux-2.6.22/include/asm-nios2nommu/signal.h	1970-01-01 10:00:00.000000000 +1000
+++ linux-2.6.22-uc0/include/asm-nios2nommu/signal.h	2007-07-12 15:23:43.000000000 +1000
@@ -0,0 +1,181 @@
