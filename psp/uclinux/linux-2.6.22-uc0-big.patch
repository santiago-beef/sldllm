+U32 Calc_CRC( const U8 *p, U32 len )
+{
+    U32 crc = (U32)~0L;
+    while (len--)
+       crc = crc_32_tab[0xFF & (crc ^ *p++)] ^ (crc >> 8);
+   
+    return crc ^ (U32)~0L;
+}
