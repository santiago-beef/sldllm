+#define set_gpio_ctrl(x) \
+        ({ GPCON(GRAB_CON_NUM((x))) &= ~(0x3 << (GRAB_CON_OFS((x))*2)); \
+           GPCON(GRAB_CON_NUM(x)) |= (GRAB_MODE(x) << (GRAB_CON_OFS((x))*2)); \
+           GPUP &= ~(1 << GRAB_OFS((x))); \
+           GPUP |= (GRAB_PULLUP((x)) << GRAB_OFS((x))); })
+#define read_gpio_bit(x)        ((GPDAT & (1<<GRAB_OFS((x)))) >> GRAB_OFS((x)))
