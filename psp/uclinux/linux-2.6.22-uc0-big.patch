+	{0x40200028, "NVECADDR"},
+	{0x4020002c, "VAR"},
+
+	/* SROM */
+	{0x40c20000, "SROM_BW"},
+	{0x40c20004, "SROM_BC0"},
+	{0x40c20008, "SROM_BC1"},
+	{0x40c2000c, "SROM_BC2"},
+
+	/* PWM timer */
+	{0x44000000, "TCFG0"},
+	{0x44000004, "TCFG1"},
+	{0x44000008, "TCON"},
+	{0x4400000c, "TCNTB0"},
+	{0x44000010, "TCMPB0"},
+	{0x44000014, "TCNTO0"},
+	{0x44000018, "TCNTB1"},
+	{0x4400001c, "TCMPB1"},
+	{0x44000020, "TCNTO1"},
+	{0x44000024, "TCNTB2"},
+	{0x44000028, "TCMPB2"},
+	{0x4400002c, "TCNTO2"},
+	{0x44000030, "TCNTB3"},
+	{0x44000034, "TCMPB3"},
+	{0x44000038, "TCNTO3"},
+	{0x4400003c, "TCNTB4"},
+	{0x44000040, "TCNTO4"},
+
+	/* CamIF */
+	{0x48000004, "CAM_STAY1"},
+	{0x48000008, "CAM_STAY2"},
+	{0x4800000c, "CAM_STAY3"},
+	{0x48000010, "CAM_STAY4"},
+	{0x48000000, "CAM_RDSTAT"},
+
+	/* Post Processor */
+	{0x4a100000, "VP_MODE"},
+	{0x4a100004, "VP_RATIO_Y"},
+	{0x4a100008, "VP_RATIO_CB"},
+	{0x4a10000c, "VP_RATIO_CR"},
+	{0x4a100010, "VP_SRC_WIDTH"},
+	{0x4a100014, "VP_SRC_HEIGHT"},
