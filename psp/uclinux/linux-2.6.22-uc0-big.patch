@@ -0,0 +1,577 @@
+/*--------------------------------------------------------------------
+ *
+ * arch/nios2nommu/kernel/process.c
+ *
+ * Derived from M68knommu
+ *
+ *  Copyright (C) 1995  Hamish Macdonald
+ *  Copyright (C) 2000-2002, David McCullough <davidm@snapgear.com>
