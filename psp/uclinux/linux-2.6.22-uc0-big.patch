--- linux-2.6.22/arch/nios2nommu/kernel/entry.S	1970-01-01 10:00:00.000000000 +1000
+++ linux-2.6.22-uc0/arch/nios2nommu/kernel/entry.S	2007-07-12 15:27:06.000000000 +1000
@@ -0,0 +1,898 @@
+/*
