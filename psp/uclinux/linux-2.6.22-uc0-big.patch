diff -Naur linux-2.6.22/drivers/mmc/host/mmc_spi.c linux-2.6.22-uc0/drivers/mmc/host/mmc_spi.c
--- linux-2.6.22/drivers/mmc/host/mmc_spi.c	1970-01-01 10:00:00.000000000 +1000
+++ linux-2.6.22-uc0/drivers/mmc/host/mmc_spi.c	2007-07-12 15:24:51.000000000 +1000
@@ -0,0 +1,1522 @@
+/*
+ * mmc_spi.c - Access an SD/MMC card using the SPI bus
+ *
+ * (C) Copyright 2005, Intec Automation,
+ *		 Mike Lavender (mike@steroidmicros)
+ * (C) Copyright 2006, David Brownell
+ * (C) Copyright 2007, Axis Communications,
+ *		 Hans-Peter Nilsson (hp@axis.com)
