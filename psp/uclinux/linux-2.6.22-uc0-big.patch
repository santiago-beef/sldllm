diff -Naur linux-2.6.22/include/asm-arm/arch-p2001/entry-macro.S linux-2.6.22-uc0/include/asm-arm/arch-p2001/entry-macro.S
--- linux-2.6.22/include/asm-arm/arch-p2001/entry-macro.S	1970-01-01 10:00:00.000000000 +1000
+++ linux-2.6.22-uc0/include/asm-arm/arch-p2001/entry-macro.S	2007-07-12 15:23:57.000000000 +1000
@@ -0,0 +1,168 @@
+/*
+ *  linux/arch/armnommu/mach-p2001/entry-macro.S
+ *
+ *  Copyright (C) 2004 Tobias Lorenz
+ *
+ *  defines machine dependent entry macros.
+ *  included in the arch/armnommu/kernel/entry.S
+ *  
