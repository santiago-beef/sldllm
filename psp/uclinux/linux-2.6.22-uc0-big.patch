+
+	dm270_uport->msr = (dm270_uport->msr & ~(DM270_UART_MSR_CLS | DM270_UART_MSR_SBLS |
+			DM270_UART_MSR_PSB | DM270_UART_MSR_PEB)) | mode;
+	dm270_uart_hwout(uport, DM270_UART_MSR, dm270_uport->msr);
+}
