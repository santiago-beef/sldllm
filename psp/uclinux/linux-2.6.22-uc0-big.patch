+static inline void
+dm270_uart_set_tx_trigger(struct uart_port *uport, unsigned short val)
+{
+	dm270_uart_hwout(uport, DM270_UART_TFCR, (dm270_uart_hwin(uport, DM270_UART_TFCR) &
