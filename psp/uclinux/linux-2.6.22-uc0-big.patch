+/*
+ * -------------------------------------------------------------------
+ * Here ends the serial interrupt routines.
+ * -------------------------------------------------------------------
+ */
+static void do_softint(struct work_struct *work)
+{
+	struct atmel_serial *info = container_of(work, struct atmel_serial, tqueue);
+	struct tty_struct *tty;
+
+	tty = info->tty;
+	if (!tty)
+		return;
