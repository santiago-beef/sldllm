+
+    cmplnstatus = pmac->RX_CMD_STAT;
+
+    if(!( cmplnstatus & mmac_rcs_VALID_mask ))
+      {
+        ++gMtipUnexpRxints;
+
+        PRINTK3
+//      printk
+              (
+               "mtip_RxInterrupt:%s, but RxStatus:0x%08X INvalid\n",
+               dev->name,
+               cmplnstatus);
+
+        /* ?...RxInterrupt condition...?                                */
+      }
+      else
+      {
+        mtip_NuRxReady(dev, cmplnstatus);
+      }
+
+    return IRQ_HANDLED;
+  }
