+	init_mm.end_code = (unsigned long) &_etext;
+	init_mm.end_data = (unsigned long) &_edata;
+	init_mm.brk = (unsigned long) 0;
+	init_task.thread.kregs = &fake_regs;
+
+#if 0
+	ROOT_DEV = MKDEV(BLKMEM_MAJOR,0);
+#endif
