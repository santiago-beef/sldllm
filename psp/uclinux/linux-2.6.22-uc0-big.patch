+static inline void
+dm270_uart_save_registers(struct uart_port *uport)
+{
+	struct dm270_uart_port *dm270_uport = (struct dm270_uart_port *)uport;
+
+	dm270_uport->msr = dm270_uart_hwin(uport, DM270_UART_MSR);
+}
