+#ifdef CONFIG_SYSCTL
+/*-----------------------------------------------------------
+ | Sysctl unregistration when driver closed
+*/
+static void mtip_sysctl_unregister(struct net_device *dev)
+{
+    struct mtip_local *lp = (struct mtip_local *)dev->priv;
+
+    unregister_sysctl_table(lp->sysctl_header);
+}
