+++ linux-2.6.22-uc0/arch/arm/mach-s3c3410/time.c	2007-07-12 15:26:11.000000000 +1000
@@ -0,0 +1,95 @@
+/*
+ *  linux/arch/armnommu/mach-s3c3410/time.c
+ *
+ *  Copyright (C) SAMSUNG ELECTRONICS 
+ *                      Hyok S. Choi <hyok.choi@samsung.com>
