+inline void flash_command(int base, int offset, short data)
+{
+	volatile unsigned short * ptr=(unsigned short*) (base);
+
+	ptr[0x555]=0xaa;
+	ptr[0x2aa]=0x55;
+	ptr[offset]=data;
+}
+
+inline void exit_se_flash(int base)
+{
+	flash_command(base, 0x555, 0x90);
+	*(unsigned short*)base=0;
+}
