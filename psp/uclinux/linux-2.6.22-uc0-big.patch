+	{0x40000004, "OSCWEST"},
+	{0x40000010, "MPLLCON"},
+	{0x40000014, "UPLLCON"},
+	{0x40000020, "CLKCON"},
+	{0x40000024, "CLKSRC"},
+	{0x40000028, "CLKDIV"},
+	{0x40000030, "PWRMAN"},
+	{0x40000038, "SOFTRESET"},
+
+	/* INT */
+	{0x40200000, "SRCPND"},
+	{0x40200004, "INTMOD"},
+	{0x40200008, "INTMSK"},
+	{0x4020000c, "PRIORITY"},
+	{0x40200010, "INTPND"},
