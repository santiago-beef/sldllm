+	if (phy_id <= MAX_PHYID) {
+		mdio_cp_sync (cp);
+		/* Shift the read command bits out. */
+		for (i = 15; i >= 0; i--) {
+			int dataval = (mii_cmd & (1 << i)) ? MDO : 0;
+
+			cpw32 (MIIRegister, dataval | MDM);
+			mdio_delay ();
+			cpw32 (MIIRegister, dataval | MDC | MDM);
+			mdio_delay ();
+		}
+
+		/* Read the two transition, 16 data, and wire-idle bits. */
+		for (i = 19; i > 0; i--) {
