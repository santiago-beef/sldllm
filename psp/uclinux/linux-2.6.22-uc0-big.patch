+					}
+					/* Rx mirror port */
+					if (pIoCtrl->u.uData[2] > 0 && pIoCtrl->u.uData[2] <= 5) {
+						uReg |= (1L << (pIoCtrl->u.uData[2] - 1)) << 1;
+					}
+					/* sniffer mode, 1 for AND 0 for OR */
+					if (pIoCtrl->u.uData[3]) {
