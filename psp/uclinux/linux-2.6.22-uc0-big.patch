+static inline 
+void arch_idle(void)
+{
+	/* TODO */
+	cpu_do_idle(/*0*/);
+}
+
+static inline 
+void arch_reset(char mode)
+{
+	if (mode == 's') {
+		/* Jump into ROM at address 0 */
+		cpu_reset(0);
+	} else {
+		WTCNT = 0x100;
+		WTDAT = 0x100;
+		WTCON = 0x8021;
+	}
+}
