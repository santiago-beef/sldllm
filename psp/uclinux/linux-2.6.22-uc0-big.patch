diff -Naur linux-2.6.22/arch/nios2nommu/kernel/sys_nios2.c linux-2.6.22-uc0/arch/nios2nommu/kernel/sys_nios2.c
--- linux-2.6.22/arch/nios2nommu/kernel/sys_nios2.c	1970-01-01 10:00:00.000000000 +1000
+++ linux-2.6.22-uc0/arch/nios2nommu/kernel/sys_nios2.c	2007-07-12 15:27:06.000000000 +1000
@@ -0,0 +1,246 @@
+/*
+ * linux/arch/nios2nommu/kernel/sys_nios2.c
+ *
+ * Copyright (C) 2004 Microtronix Datacom Ltd.
+ *
+ * This file contains various random system calls that
+ * have a non-standard calling sequence on the Linux/nios2nommu
+ * platform.
