+					pIoCtrl->u.uData[1] = (uReg >> 6) & 0x1f;
+					pIoCtrl->u.uData[2] = (uReg >> 1) & 0x1f;
+					pIoCtrl->u.uData[3] = (uReg & 0x00010000) ? TRUE : FALSE;
+					pIoCtrl->u.uData[4] = (uReg & 0x00000001) ? TRUE : FALSE;
+				}
+				nRet = 0;
+			}
+			break;
+
+		case CONFIG_SW_SUBID_ADV_THRESHOLD:
