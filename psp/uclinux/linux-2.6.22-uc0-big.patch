+				uReg = KS8695_READ_REG(KS8695_SWITCH_CTRL1);	/* 0xE804 */
+				if (CONFIG_SWITCH_SET == pIoCtrl->byId) {
+					uReg &= 0x00ffffff;	/* bit 31:24 */
+					uReg |= (pIoCtrl->u.uData[0] & 0xff) << 24;
+					KS8695_WRITE_REG(KS8695_SWITCH_CTRL1, uReg);
