+{
+}
+
+static void elfinuart_break_ctl(struct uart_port *port, int break_state)
+{
+        u_int ucon;
+
+        ucon = UART_UCON(port);
+
+        if (break_state == -1)
+                ucon |= UCON_BRK_SIG;
+        else
+                ucon &= ~UCON_BRK_SIG;
+
+        UART_UCON(port) = ucon;
+}
+
+static irqreturn_t elfinuart_rx_int(int irq, void *dev_id, struct pt_regs *regs)
+{
+        struct uart_port *port = dev_id;
+        elfinuart_rx_char(port);
+
+        return IRQ_HANDLED;
+}
