+static inline void
+dm270_uart_disable_breaks(struct uart_port *uport)
+{
+	dm270_uart_hwout(uport, DM270_UART_LCR,
+			dm270_uart_hwin(uport, DM270_UART_LCR) & ~DM270_UART_LCR_BOC);
