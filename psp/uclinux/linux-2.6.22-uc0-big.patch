+int nr_dbg_plugs_idle (void)
+{
+	int result;
+
+	result = nr_plugs_idle ();
+	if (gdb.stop)
+	{
+		gdb.stop = 0;
+//;dgt2;tmp;		asm ("TRAP #5");
+	}
+	return result;
+}
