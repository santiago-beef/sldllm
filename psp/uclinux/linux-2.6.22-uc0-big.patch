diff -Naur linux-2.6.22/arch/nios2nommu/mm/memory.c linux-2.6.22-uc0/arch/nios2nommu/mm/memory.c
--- linux-2.6.22/arch/nios2nommu/mm/memory.c	1970-01-01 10:00:00.000000000 +1000
+++ linux-2.6.22-uc0/arch/nios2nommu/mm/memory.c	2007-07-12 15:27:06.000000000 +1000
@@ -0,0 +1,212 @@
+/*
+ *  linux/arch/nio2nommu/mm/memory.c
+ *
+ *  Copyright (C) 1995  Hamish Macdonald
+ *  Copyright (C) 1998  Kenneth Albanowski <kjahds@kjahds.com>,
