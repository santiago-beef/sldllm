+
+/**
+ * real_bank1_set_param: blah blah
+ */
+static __inline__ void real_bank1_set_param(int bw_val, int bc1_val)
+{
+        SROM_BW &= ~0x38;
+        SROM_BW |= bw_val;
+        SROM_BC1 = bc1_val;
+}
+
+/**
+ * bank1_set_state - set bank1 timing
+ * @state - state
+ *
+ * long description
