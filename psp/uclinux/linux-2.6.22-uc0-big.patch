+/****************************************************************************/
+
+void myputc(char c)
+{
+	int i;
+	for (i = 0; (i < 0x10000); i++) {
+		if (readb(0xfc060000+MCFUART_USR) & MCFUART_USR_TXREADY)
+			break;
+	}
+	writeb(c, 0xfc060000+MCFUART_UTB);
+	for (i = 0; (i < 0x10000); i++) {
+		if (readb(0xfc060000+MCFUART_USR) & MCFUART_USR_TXREADY)
+			break;
+	}
+}
+
+static void mcf_console_putc(struct console *co, const char c)
+{
+	struct uart_port *port = &(mcf_ports + co->index)->port;
+	int i;
+
+	for (i = 0; (i < 0x10000); i++) {
+		if (mcf_getreg(port, MCFUART_USR) & MCFUART_USR_TXREADY)
+			break;
+	}
+	mcf_setreg(port, MCFUART_UTB, c);
+	for (i = 0; (i < 0x10000); i++) {
+		if (mcf_getreg(port, MCFUART_USR) & MCFUART_USR_TXREADY)
+			break;
+	}
+}
+
+/****************************************************************************/
+
+static void mcf_console_write(struct console *co, const char *s, unsigned int count)
+{
+	for ( ; (count); count--, s++) {
+		mcf_console_putc(co, *s);
+		if (*s == '\n')
+			mcf_console_putc(co, '\r');
+	}
+}
