diff -Naur linux-2.6.22/include/asm-nios2nommu/a.out.h linux-2.6.22-uc0/include/asm-nios2nommu/a.out.h
--- linux-2.6.22/include/asm-nios2nommu/a.out.h	1970-01-01 10:00:00.000000000 +1000
+++ linux-2.6.22-uc0/include/asm-nios2nommu/a.out.h	2007-07-12 15:23:43.000000000 +1000
@@ -0,0 +1,85 @@
+/* $Id: a.out.h,v 1.1 2006/07/05 06:20:25 gerg Exp $ */
+/*
+ * Copyright (C) 2004 Microtronix Datacom Ltd.
+ *
+ * All rights reserved.          
