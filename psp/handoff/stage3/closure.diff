+        cnt = Counter()
+        for r in m.P + m.W + m.M:
+            if r.get("nw7or8") and lo <= r["_t0"] <= hi:
+                cnt[(r["cmd"], F.ORIGIN_NAMES[r["ctx"] & 3])] += 1
+        return dict(cnt)
