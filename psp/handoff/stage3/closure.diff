+    def edge_windows(self):
+        """K6 (10.7 step 6): thread windows S5..S20 near a tick edge, with the
+        start-phase shift delta of each command (DELTA_START): a window
+        starting within delta after an edge could have straddled it without
+        the instrumentation (a straddle removed); a window ending within delta
+        after an edge could have ended before it (a straddle created).  Counted
+        for every tick edge (the density) and for watchdog edges (1250k)."""
+        m = self.m
+        c = Counter()
+        n = Counter()
+        for r in m.P:
+            cmd = r["cmd"]
+            if cmd not in DELTA_START:
+                continue
+            d = DELTA_START[cmd]
+            n[cmd] += 1
+            s5 = r["c_in"] + CIN_TO_S5[cmd]
+            s5_tick = r["tick_in"] + (1 if s5 >= CPT else 0)
+            s5 = s5 - CPT if s5 >= CPT else s5
+            s20 = r["c_out"] - S20_BEFORE_COUT[cmd]
+            s20_tick = r["tick_in"] + r["dtick"] - (1 if s20 < 0 else 0)
+            s20 = s20 + CPT if s20 < 0 else s20
+            if s5 < d:
+                c[(cmd, "start after edge")] += 1
+                if s5_tick % WD == 0:
+                    c[(cmd, "start after watchdog edge")] += 1
+            if s5 > CPT - d:
+                c[(cmd, "start before edge")] += 1
+            if s20 < d:
+                c[(cmd, "end after edge")] += 1
+                if s20_tick % WD == 0:
+                    c[(cmd, "end after watchdog edge")] += 1
+            if s20 > CPT - d:
+                c[(cmd, "end before edge")] += 1
+        lines = []
+        for cmd in sorted(n):
+            d = DELTA_START[cmd]
+            lines.append("cmd 0x%02x, delta %.2f us: of %d windows, %d start and %d end within delta after a tick edge "
+                         "(%d, %d at a watchdog edge: straddles the shift could have removed / created), %d start and "
+                         "%d end within delta before one; density %.4f %%"
+                         % (cmd, d * 1e6 / COUNT_HZ, n[cmd], c[(cmd, "start after edge")], c[(cmd, "end after edge")],
+                            c[(cmd, "start after watchdog edge")], c[(cmd, "end after watchdog edge")],
+                            c[(cmd, "start before edge")], c[(cmd, "end before edge")],
+                            100.0 * (c[(cmd, "start after edge")] + c[(cmd, "end after edge")]) / max(1, n[cmd])))
+            lines[-1] = lines[-1].replace("density", "fraction of windows within delta after an edge")
+        lines.append("a thread command resumed after a Nop resumes %.2f us later (DELTA_RESUME); 7.3's bound is "
+                     "delta x the largest start-phase density, the counts above give that density"
