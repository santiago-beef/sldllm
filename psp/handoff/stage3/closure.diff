+/* The package's BUILD directory (Stage 3 closure, verifier advisory 1):
+ * $PSC_PACKAGE_BUILD, else work/deploy/uClinux_TRACE/BUILD relative to test/
+ * (where run.sh and checks.sh run the binary), else its absolute path.
+ * Fills the banner.txt path and build_id.txt's first word; 0 if none. */
+static int packaged_build(char *bpath, size_t bn, char *hx, size_t hn)
+{
+	const char *cand[3];
+	int i;
+
+	cand[0] = getenv("PSC_PACKAGE_BUILD");
+	cand[1] = "../../deploy/uClinux_TRACE/BUILD";
+	cand[2] = "/home/ubuntu/psp/work/deploy/uClinux_TRACE/BUILD";
+	for (i = 0; i < 3; i++) {
+		char idp[600];
+		FILE *fb, *fi;
+
+		if (!cand[i])
+			continue;
+		snprintf(bpath, bn, "%s/banner.txt", cand[i]);
+		snprintf(idp, sizeof(idp), "%s/build_id.txt", cand[i]);
+		fb = fopen(bpath, "rb");
+		fi = fopen(idp, "r");
+		if (fb && fi && hn >= 32 && fscanf(fi, "%31s", hx) == 1) {
+			fclose(fb);
+			fclose(fi);
+			printf("  packaged BUILD: %s (build_id.txt %s)\n", cand[i], hx);
+			return 1;
+		}
+		if (fb)
+			fclose(fb);
+		if (fi)
+			fclose(fi);
+	}
+	printf("  packaged BUILD not found ($PSC_PACKAGE_BUILD, ../../deploy/uClinux_TRACE/BUILD): "
+	       "packaged-banner rows NOT RUN\n");
+	return 0;
+}
