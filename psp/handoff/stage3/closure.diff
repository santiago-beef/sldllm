+def image_identity(bd, image_sha, expect):
+    """10.1 / K3: the BUILD directory must belong to the released image: its
+    SHA256SUMS verifies every file it lists (IMAGE.sha256 included), and
+    IMAGE.sha256 names vmlinux-0.22.bin with the expected hash (default: the
+    G3 R3 record, A.RELEASE_IMAGE_SHA256). Returns (expect, errors, note)."""
+    import hashlib
+    if expect == "any":
+        return None, [], "image identity check DISABLED (--expect-image any)"
+    errs = []
+    if not bd:
+        return expect, ["image identity not established: no BUILD directory (--build) with IMAGE.sha256"], ""
+    sums = os.path.join(bd, "SHA256SUMS")
+    listed = {}
+    if not os.path.exists(sums):
+        errs.append("BUILD/SHA256SUMS missing")
+    else:
+        with open(sums) as f:
+            for line in f:
+                q = line.split()
+                if len(q) >= 2:
+                    listed[q[1].lstrip("*")] = q[0].lower()
+        for name, h in sorted(listed.items()):
+            fp = os.path.join(bd, name)
+            if not os.path.exists(fp):
+                errs.append("BUILD/SHA256SUMS lists %s, which is missing" % name)
+                continue
+            with open(fp, "rb") as fi:
+                if hashlib.sha256(fi.read()).hexdigest() != h:
+                    errs.append("BUILD/%s does not match BUILD/SHA256SUMS" % name)
+        if "IMAGE.sha256" not in listed:
+            errs.append("BUILD/SHA256SUMS does not cover IMAGE.sha256")
+    img = os.path.join(bd, "IMAGE.sha256")
+    if image_sha is None or not os.path.exists(img):
+        errs.append("BUILD/IMAGE.sha256 missing")
+    else:
+        with open(img) as fi:
+            q = fi.read().split()
+        if len(q) < 2 or q[1].lstrip("*") != "vmlinux-0.22.bin":
+            errs.append("BUILD/IMAGE.sha256 does not name vmlinux-0.22.bin")
+        if image_sha.lower() != expect.lower():
+            errs.append("BUILD belongs to image sha256 %s, not the released image %s (G3 R3)" % (image_sha, expect))
+    note = "SHA256SUMS verifies %d files" % len(listed) if listed and not errs else ""
+    return expect, errs, note
+
