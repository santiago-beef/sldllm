+    def stack_headroom(self):
+        """K8 (10.7 step 6): stack headroom at each Nop from the W record's
+        interrupted sp: kernel mode (ext_flags KMODE) = sp - stack base - 52, and
+        that minus the Nop path's 176 + 344 B; user mode: the Nop runs on the
+        kernel stack top (8192 - 32 - 52 - 520 B)."""
+        km, um, flagged = [], 0, []
+        for w in self.m.WT:
+            e = w.get("ext") or {}
+            if not (e.get("ext_flags", 0) & F.EXT_F_REGS_VALID):
+                continue
+            if e["ext_flags"] & F.EXT_F_KMODE:
+                # sp - (its 8 KB stack's base) - sizeof(thread_info); a sp exactly on a block
+                # boundary is the top of the block below (an empty stack), hence sp - 1
+                raw = e["sp"] - ((e["sp"] - 1) & ~(THREAD_SIZE - 1)) - TI_SIZE
+                after = raw - PT_SIZE - NOP_DEPTH
+                km.append((after, raw, w["seq"]))
+                if after < HEADROOM_FLAG:
+                    flagged.append(w["seq"])
+            else:
+                um += 1
+        lines = []
+        user_room = THREAD_SIZE - STACK_TOP_RESERVE - TI_SIZE - PT_SIZE - NOP_DEPTH
+        if km:
+            lo = min(km)
+            lines.append("stack headroom at the Nop (K8): %d kernel-mode W records, minimum sp - stack base - 52 = %d B, "
+                         "after the Nop path's %d B: %d B (W seq %d); %d user-mode W records (Nop on the kernel stack "
+                         "top, %d B left)" % (len(km), lo[1], PT_SIZE + NOP_DEPTH, lo[0], lo[2], um, user_room))
+        else:
+            lines.append("stack headroom at the Nop (K8): no kernel-mode W record; %d user-mode (%d B left)"
+                         % (um, user_room))
+        if flagged:
+            lines.append("**STACK HEADROOM BELOW %d B after the Nop path** at W seq %s" % (HEADROOM_FLAG, flagged[:20]))
+        return lines, flagged
 
