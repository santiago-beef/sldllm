+    def mmio_bound(self):
+        """K5: an upper bound of the uncached MMIO latency m from the clean P
+        records: m <= (c_out - c_in - I) / N (Counts), with I and N the
+        executed instructions and MMIO accesses of that record's path (lower
+        bounds, so the bound stays an upper bound; cache misses only raise it).
+        Returns (m_counts or None, n_records, the record that gives it)."""
+        best, n, arg = None, 0, None
+        for r in self.m.P:
+            cmd = r["cmd"]
+            if cmd not in CMD_I0 or r["ret"] <= 0 or r["retries"] or r["drain"] or r["dtick"] or r["wn"] or \
+                    r["preempt_delta"] or r["lc_n"] or r["ack_polls"] >= 1000000:
+                continue
+            nw = 7 if r.get("nw7or8") else r["nwords"]
+            if nw < 1:
+                continue
+            i = CMD_I0[cmd] + 11 * r["ack_polls"] + 15 * nw + 5 * r["rx"][1]
+            k = 16 + r["ack_polls"] + 2 * nw - (1 if nw >= 8 else 0)
+            dur = r["c_out"] - r["c_in"]
+            n += 1
+            v = (dur - i) / float(k)
+            if best is None or v < best:
+                best, arg = v, r
+        return best, n, arg
+
+    def g3_gap(self):
+        """K5 (10.7 steps 6 and 8): the recorded 0x33 -> 0x08 gap g (c_out of
+        the 0x33 to c_in of the 0x08), its distribution, and the G3-low gap
+        (S20 -> S13) with and without the instrumentation, for m in [0, m_ub].
+        Returns (lines, summary or None)."""
+        m = self.m
+        gs = []
+        for p in m.POLL:
+            a33, a08 = p.get("_p33"), p.get("_p08")
+            if a33 is not None and a08 is not None and a08["_t0"] > a33["_t1"]:
+                gs.append(a08["_t0"] - a33["_t1"])
+        us = lambda c: c * 1e6 / COUNT_HZ
+        if not gs:
+            return ["G3-low gap: no POLL with both commands"], None
+        gs.sort()
+        q = {"min": gs[0], "p1": gs[int(0.01 * (len(gs) - 1))], "median": gs[len(gs) // 2]}
+        st = m.stats[-1] if m.stats else None
+        cost_last = st["p_rec_cost_last"] if st else P33_COST_INSTR
+        cost_max = st["p_rec_cost_max"] if st else P33_COST_INSTR
+        mub, nmub, rarg = self.mmio_bound()
+        mub_c = max(0.0, mub) if mub is not None else None
+        lines = ["G3-low gap (K5): recorded g = c_in(0x08) - c_out(0x33) over %d polls: min %.2f us, 1st percentile "
+                 "%.2f us, median %.2f us" % (len(gs), us(q["min"]), us(q["p1"]), us(q["median"]))]
+        if mub_c is None:
+            lines.append("MMIO latency bound: no clean P record (ret > 0, no retry, drain 0, dtick 0, wn 0, not "
+                         "preempted); m unbounded, the gap is given for m = 0 only")
+        else:
+            lines.append("MMIO latency bound from the shortest clean command: m <= %.0f ns (%d records; P seq %d "
+                         "cmd 0x%02x, c_out - c_in %d Counts, ack_polls %d, nwords %s)"
+                         % (us(mub_c) * 1000, nmub, rarg["seq"], rarg["cmd"], rarg["c_out"] - rarg["c_in"],
+                            rarg["ack_polls"], nwtext(rarg)))
+        excess = max(0, cost_last - P33_COST_INSTR)
+        summ = {}
+        for k in ("min", "p1", "median"):
+            g = q[k]
+            new_lo = g + G3GAP_OUT_INSTR
+            new_hi = new_lo + G3GAP_MMIO * (mub_c or 0)
+            base_lo = new_lo - G3GAP_ADDED_INSTR - excess
+            base_hi = new_hi - G3GAP_ADDED_INSTR - excess
+            cross = us(base_lo) < G3GAP_HINT_US <= us(new_hi)
+            summ[k] = (us(base_lo), us(base_hi), us(new_lo), us(new_hi), cross)
+            lines.append("G3-low gap S20 -> S13 at the %s g: instrumented %.2f-%.2f us, baseline equivalent %.2f-%.2f "
+                         "us (minus %d instructions and the p_rec_cost excess %d Counts); %.1f us %s"
+                         % (k, us(new_lo), us(new_hi), us(base_lo), us(base_hi), G3GAP_ADDED_INSTR, excess,
+                            G3GAP_HINT_US, "lies between the two: the instrumentation could have moved this gap "
+                            "across it (the one masking direction, 7.3)" if cross else "is not crossed"))
+        lines.append("p_rec_cost last %d, max %d Counts (%d of them instructions on the cached path); constants: %d "
+                     "instructions outside g, %d MMIO, %d instructions added (stage3/measure, 1 IPC UNVERIFIED)"
+                     % (cost_last, cost_max, P33_COST_INSTR, G3GAP_OUT_INSTR, G3GAP_MMIO, G3GAP_ADDED_INSTR))
+        return lines, summ
