+out:	/* PSC 2.1 A4: hand the captures to the recorder, then return as before */
+	PSC_XFER_OUT(dmy, spin, spin_ack, dlast, st9, sttx);
 	return result;
 }
 
+/* PSC (DESIGN 2.1): the recording wrapper, arch/mips/psp/psc.c. */
