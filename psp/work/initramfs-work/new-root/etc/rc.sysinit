#!/bin/sh

printf "\\n\\t\\t\\033[1;31muC\\033[1;37mlinux on PSP 0.22\\033[0m\\n"

printf "\\033[37mMounting /proc filesystem\\t\\t\\t\\033[0m"
mount -t proc proc /proc
printf "[  \\033[32mOK\\033[37m  ]\\033[0m\\n"

printf "\\033[37mMounting MemoryStick filesystem\\t\\t\\t\\033[0m"
mount -t vfat /dev/ms0 /ms0
printf "[  \\033[32mOK\\033[37m  ]\\033[0m\\n"

printf "\\033[37mLaunching On-Screen Keyboard\\t\\t\\t\\033[0m"
psposk2 `cat /proc/cmdline|sed 's,.*osk=\([^ ]*\).*,-s\1,'`&
printf "[  \\033[32mOK\\033[37m  ]\\033[0m\\n"

printf "\\033[37mLaunching text console mouse daemon\\t\\t\\033[0m"
pspmd -s&
printf "[  \\033[32mOK\\033[37m  ]\\033[0m\\n"

printf "\\033[37mLaunching PSC collector\\t\\t\\t\\033[0m"
pscol&
printf "[  \\033[32mOK\\033[37m  ]\\033[0m\\n"
